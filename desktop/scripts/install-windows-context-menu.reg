Windows Registry Editor Version 5.00

; Register "Send to Beginning Android" in Windows File Explorer context menu (No Admin required)
[HKEY_CURRENT_USER\Software\Classes\*\shell\BeginningAndroid]
@="Send to Beginning Android"
"Icon"="\"%LOCALAPPDATA%\\BeginningAndroid\\bin\\beginning-android.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\*\shell\BeginningAndroid\command]
@="\"%LOCALAPPDATA%\\BeginningAndroid\\bin\\beginning-android.exe\" send \"%1\""
