# Beginning Android Relay Server Configuration

# Listening port (default: 8080)
PORT=8080

# Listening host (default: 0.0.0.0)
HOST=0.0.0.0

# Optional TLS / HTTPS configuration
# Leave empty for unencrypted HTTP/WS (e.g. behind reverse proxy like Nginx or Cloudflare)
TLS_CERT=
TLS_KEY=

# Inactive room cleanup timeout in seconds (default: 300 = 5 minutes)
STALE_TIMEOUT=300
